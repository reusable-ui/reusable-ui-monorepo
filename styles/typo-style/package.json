{
  "name": "@reusable-ui/typo-style",
  "version": "7.0.0",
  "description": "Styles common typography elements (paragraphs, headings, blockquotes, inline formatting, and more) for consistent styling and behavior across browsers.",
  "keywords": [
    "typography-style",
    "typography-system",
    "typography",
    "styling",
    "css-variables",
    "reset",
    "auto-spacing",
    "ui-components",
    "css-in-js",
    "reusable-ui"
  ],
  "author": "HeyMarco <31385284+heyymarco@users.noreply.github.com>",
  "homepage": "https://reusableui.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reusable-ui/reusable-ui-monorepo.git",
    "directory": "styles/typo-style"
  },
  "bugs": {
    "url": "https://github.com/reusable-ui/reusable-ui-monorepo/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./index": "./dist/index.js",
    "./index.js": "./dist/index.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist playwright/.cache playwright-report test-results .next",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "lint": "eslint .",
    "build": "npm run clean && npm run tsc && npm run lint",
    "ncu": "ncu --peer",
    "ncu:upgrade": "ncu --peer --upgrade",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest"
  },
  "dependencies": {
    "@cssfn/core": "^4.0.0"
  },
  "peerDependencies": {
    "@reusable-ui/border-config": "^7.0.0",
    "@reusable-ui/color-config": "^7.0.0",
    "@reusable-ui/css-prefix-default": "^7.0.0",
    "@reusable-ui/radius-config": "^7.0.0",
    "@reusable-ui/typo-config": "^7.0.0",
    "rxjs": "^7.8.0"
  }
}
